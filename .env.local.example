# NEXT_PUBLIC_* is inlined in the browser (optional legacy base; jobs/auth use same-origin /api proxies).
# Backend API URL — port 8000 (NOT the Next.js frontend port 3000).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Backend URL used by Next.js Route Handlers when proxying /api/v1/* to Python. Set this to an address
# your dev machine / Docker host can reach (localhost, 127.0.0.1, or an internal hostname — not necessarily
# the same as a public IP the browser can open).
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001

# VPS example (replace with your IP/domain):
# NEXT_PUBLIC_API_URL=http://147.93.180.179:8000
# API_INTERNAL_URL=http://127.0.0.1:8000
# Open the app at https://YOUR_IP (nginx on 443). REST uses same-origin /api/* proxies.
# WebSockets on HTTPS use wss://YOUR_IP/api/v1/ws — nginx must upgrade and proxy /api/ to the backend.
# If using nginx/Caddy in front of Next.js, set proxy_redirect off and forward Host / X-Forwarded-* headers.
