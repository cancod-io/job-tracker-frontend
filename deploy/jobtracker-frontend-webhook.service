[Unit]
Description=Job Tracker frontend deploy webhook listener (port 8083)
After=network.target docker.service
Requires=docker.service

[Service]
WorkingDirectory=/opt/job-tracker-frontend
EnvironmentFile=/opt/job-tracker-frontend/.env
ExecStart=/usr/bin/python3 /opt/job-tracker-frontend/scripts/webhook_listener.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
